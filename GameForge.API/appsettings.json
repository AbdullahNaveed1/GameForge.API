{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=GameForgeDb;Username=postgres;Password=YOUR_SUCCESSFUL_PASSWORD",
        "Redis": "localhost:6379,abortConnect=false"
    },
    "Jwt": {
        "Key": "SuperSecretGameForgeAuthenticationKey2026!MustBeVeryLong",
        "Issuer": "GameForgeAPI",
        "Audience": "GameForgeClients"
    },
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "*",
                "Period": "1s",
                "Limit": 30
            },
            {
                "Endpoint": "*:/api/auth/*",
                "Period": "1m",
                "Limit": 10
            }
        ]
    }
}